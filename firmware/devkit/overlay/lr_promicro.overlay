/* ProMicro nRF52840 (nice!nano v2 clone) + a PDM mic breakout (pins 3V GND SEL CLK DAT), built on the XIAO board
 * definition: same chip, different pins.
 *
 * LR-P3 (hardware/lr-p3/README.md has the pin table): DAT-P0.06, CLK-P0.08, SEL-3V, GND-GND, 3V-P0.17 (the mic,
 * ~1 mA, is powered from a GPIO like the XIAO's own). All three are full-speed pins (not "low frequency I/O", nRF52840
 * PS table 145): the PDM clock is 1.28 MHz. The breadboard prototype had SEL on GND; mic.c samples in mono either way. */
/ {
	zephyr,user {
		pdm-din-gpios = <&gpio0 6 0>;
		pdm-clk-gpios = <&gpio0 8 0>;
		pdm-pwr-gpios = <&gpio0 17 0>;
		/* The nice!nano's VCC pin, switched by P0.13 (high: on): the SD module there. sdcard.c turns it off and on
		 * before mounting, so a card left stuck mid-command (a reset, a lost link mid-read) starts clean */
		sd-pwr-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
	};
};

/* One LED on P0.15 (active high), red on these clones (USB-C up, chip side: the right one), driven as led2 (the XIAO's
 * blue): short status flashes, CONFIG_LR_ONE_LED (led_code.h). The blue one beside it is the charger's, not ours.
 * led0/led1 go to the unrouted bottom pads P1.02 / P1.07. */
&led0 { gpios = <&gpio1 2 GPIO_ACTIVE_HIGH>; };
&led1 { gpios = <&gpio1 7 GPIO_ACTIVE_HIGH>; };
&led2 { gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>; };

/* No QSPI flash on the ProMicro (P0.20/22/24 are header pins here) */
&qspi { status = "disabled"; };

/* Its bootloader (nice!nano, UF2 0.6.0) sits on SoftDevice S140 6.1.1: the application starts at 0x26000,
 * not the XIAO's 0x27000 */
&flash0 {
	partitions {
		/delete-node/ partition@27000;
		code_partition: partition@26000 {
			label = "code_partition";
			reg = <0x26000 0xc6000>;
		};
	};
};

/* The SD module on four full-speed pins down the left header, below the mic: CS-P0.20, MOSI-P0.22, CLK-P0.24,
 * MISO-P1.00 (the module's own order); 3V3 from VCC, GND from the right header. */
&custom_spi {
	group1 {
		psels = <NRF_PSEL(SPIM_SCK, 0, 24)>,
			<NRF_PSEL(SPIM_MOSI, 0, 22)>,
			<NRF_PSEL(SPIM_MISO, 1, 0)>;
	};
};
/* SPIM (EasyDMA): a block moves without an interrupt per byte. Full-speed pins, the card's power switched at boot
 * and reset over SPI before it mounts (sdcard.c): the 10-03 hang on the XIAO (lr_sd.overlay) did not show here. */
&spi2 {
	compatible = "nordic,nrf-spim";
	cs-gpios = <&gpio0 20 GPIO_ACTIVE_LOW>;
};
