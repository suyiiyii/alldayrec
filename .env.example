# live-record server configuration. Copy to .env and fill in; the server refuses to start without the required ones.
# Who it serves is not here: tenants.json beside this file, mode 600 (server/tenant.py): per tenant its id (the metrics'
# instance label), its token (open any page once with ?token=<it>, a year-long cookie does the rest), its data dir
# (live.db, <date>.passes.jsonl, owner-redimnet2.npz, voices/clips/) and its recordings dir (chunks/<device>/<date>/<HH>.<ext>).

# --- required: the key of each ASR engine chosen below (ENGINE=qwen: DASHSCOPE_API_KEY) and the LLM_* at the end ---

# --- optional ---
MODELS_DIR=/opt/lr-models                      # FireRedVAD and ReDimNet2 for onnxruntime, sha256-pinned in infer.py (make them: cd server && uv run --group export python export_onnx.py)
PORT=8770
HOST=127.0.0.1           # 0.0.0.0 when a reverse proxy on another machine fronts the server
FIRMWARE_TOKEN=          # firmware uploads (firmware/devkit/lr_release.py) need it besides a tenant's token; empty: no uploads
FILE_MODELS=stepaudio-2.5-asr-8006,doubao-seedasr-2.0   # file-mode engines in order; the second takes windows the first refuses
REFINE_EVERY_S=20         # draft layer (a page watching): a pass after this long without a pause
ENGINE=qwen               # final layer's ASR provider: volc (Volcengine seed-asr-2.0, VOLC_ASR_KEY) | qwen (Bailian qwen-audio-3.1
                          # file job: text + speakers, DASHSCOPE_API_KEY) | stepfun (SSE text + file-mode speakers, both StepFun
                          # pay-as-you-go) | stepfun-sse (text only, our voiceprints) | stepfun-file (file-mode service) | local (sherpa-onnx
                          # X-ASR zh-en in this process, no key: text only, our voiceprints; the model is fetched into MODELS_DIR at first use)
DRAFT_ENGINE=             # draft layer's provider; empty: ENGINE. stepfun-sse is the fast one; qwen-stream streams the audio
                          # while a page watches (Bailian qwen-audio-3.1-asr-flash-streaming, DASHSCOPE_API_KEY): words as they are said
ENGINE_FALLBACK=          # a window ENGINE / DRAFT_ENGINE fails on (402, 451, 5xx, timeout) goes to this one; empty: retried later
VOLC_ASR_KEY=             # Volcengine Ark Agent Plan API key
STEPFUN_API_KEY=          # StepFun key (stepfun, stepfun-sse)
DASHSCOPE_API_KEY=        # Alibaba Bailian key, Beijing region (qwen)
ASR_UPLOAD_BRIDGE_URL=    # stepfun, stepfun-file only (any of ENGINE, DRAFT_ENGINE, ENGINE_FALLBACK), all four then required:
                          # POST {filename, content_type} -> {upload_url, download_url}
ASR_UPLOAD_BRIDGE_TOKEN=
ASR_SERVICE_URL=          # file-mode ASR with speakers and word times: POST /audio/transcriptions {audio_url, model}, GET /jobs/{id}
ASR_SERVICE_BASIC_AUTH=   # user:password
LOCAL_ASR_URL=            # local: where its model tarball comes from; empty: GitHub's release (local_asr.py), a mirror's copy of the same tarball works
STEPFUN_SSE_URL=          # empty: pay-as-you-go https://api.stepfun.com/v1/audio/asr/sse (Step Plan: .../step_plan/v1/audio/asr/sse)
RECAP_AT=10:00            # yesterday's recap (recap.py, a card on /conversations) is written then; empty: never
VM_INGEST_URL=            # https://example.com/api/v1/import/prometheus (VictoriaMetrics): lr_* metrics pushed every minute; empty: none
VM_INGEST_USER=           # ... its basic auth
VM_INGEST_PASSWORD=
TURN_GAP_S=0              # >0 merges a speaker's neighbouring sentences closer than this into one row
LIVE_DATA=                # the offline scripts only (owner.py, replay_case.py): a tenant's data dir
RECORDINGS_DIR=           # ... and its recordings dir
OWNER_LABELS=             # owner.py only: jsonl of windows known to be the owner's voice
CASES_DIR=                # eval_all.sh only: directory of ground-truth cases
# replay_case.py / service_case.py only: EMB_MODEL (CAM++ onnx), SEG_MODEL, OWNER_SURE, LINK_MIN, OWNER_DEFAULT_DEVICE

# --- conversation summaries, 问 AI and the daily recap (required) ---
LLM_BASE_URL=https://example.com/v1   # OpenAI-compatible; POST /chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-6-luna
