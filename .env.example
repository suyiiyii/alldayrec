# alldayrec server settings. Copy to .env and fill in; the server refuses to start without the required ones and
# says which are missing. docker-compose.yml reads this file too (it sets HOST, PORT and MODELS_DIR itself).
# Comments go on their own lines: Docker Compose would read "VAR=   # comment" as the value "# comment".
#
# Who it serves is not here: tenants.json (beside server/; data/tenants.json in Docker), mode 600 (server/tenant.py):
# per person an id, a token (open any page once with ?token=<it>, a year-long cookie does the rest), a data dir
# (live.db, <date>.passes.jsonl, owner-redimnet2.npz, voices/clips/) and a recordings dir (chunks/<device>/<date>/<HH>.<ext>).

# --- required: speech-to-text ---

# The final layer's ASR provider:
#   qwen         Alibaba Cloud Bailian qwen-audio-3.1 file job: text + speakers (DASHSCOPE_API_KEY)
#   volc         Volcengine seed-asr-2.0 (VOLC_ASR_KEY)
#   stepfun-sse  StepFun SSE: text only, our voiceprints (STEPFUN_API_KEY)
#   stepfun      StepFun SSE text + file-mode speakers; stepfun-file: file mode alone. Both also need your own
#                upload bridge and file-mode ASR service (ASR_* below)
#   local        sherpa-onnx X-ASR zh-en in this process, no key: text only, speakers from our voiceprints; the model
#                (~170 MB) is fetched into MODELS_DIR at first use. Worse than qwen on far-field audio.
ENGINE=qwen
# Alibaba Cloud Bailian (DashScope) key, Beijing region: qwen, qwen-stream
DASHSCOPE_API_KEY=

# --- required: the LLM (conversation summaries, to-dos, 问 AI, the daily recap), always an external service ---

# Any OpenAI-compatible POST /chat/completions that handles tool calls and response_format json_object: a cloud API,
# or a server you run yourself (vLLM, llama.cpp, Ollama). The example is Bailian's compatible mode: the same key as above.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-plus

# --- optional ---

# FireRedVAD and ReDimNet2 for onnxruntime, sha256-pinned in infer.py; the missing ones are downloaded here at start
# (make them yourself: cd server && uv run --group export python export_onnx.py). Absolute, writable.
MODELS_DIR=/opt/lr-models
PORT=8770
# 0.0.0.0 when a reverse proxy on another machine fronts the server
HOST=127.0.0.1
# The draft layer's provider (a page watching); empty: ENGINE. qwen-stream streams the audio while a page watches
# (Bailian qwen-audio-3.1-asr-flash-streaming, DASHSCOPE_API_KEY): words as they are said. stepfun-sse is fast too.
DRAFT_ENGINE=
# A window ENGINE / DRAFT_ENGINE fails on (402, 451, 5xx, timeout) goes to this one; empty: retried later
ENGINE_FALLBACK=
# Volcengine Ark Agent Plan API key: volc
VOLC_ASR_KEY=
# StepFun key: stepfun, stepfun-sse
STEPFUN_API_KEY=
# Empty: pay-as-you-go https://api.stepfun.com/v1/audio/asr/sse (Step Plan: .../step_plan/v1/audio/asr/sse)
STEPFUN_SSE_URL=
# local: where its model tarball comes from; empty: this project's GitHub release (server/local_asr.py). A mirror's
# copy of the same tarball works.
LOCAL_ASR_URL=
# Yesterday's recap (recap.py, a card on /conversations) is written then; empty: never
RECAP_AT=10:00
# Draft layer (a page watching): a pass after this long without a pause
REFINE_EVERY_S=20
# >0 merges a speaker's neighbouring sentences closer than this into one row
TURN_GAP_S=0
# Firmware uploads (firmware/devkit/lr_release.py) need it besides a tenant's token; empty: no uploads
FIRMWARE_TOKEN=
# https://example.com/api/v1/import/prometheus (VictoriaMetrics): lr_* metrics pushed every minute, with its basic
# auth; empty: none
VM_INGEST_URL=
VM_INGEST_USER=
VM_INGEST_PASSWORD=

# --- advanced: stepfun and stepfun-file only (as ENGINE, DRAFT_ENGINE or ENGINE_FALLBACK); all four are then required ---

# Your upload bridge: POST {filename, content_type} -> {upload_url, download_url}
ASR_UPLOAD_BRIDGE_URL=
ASR_UPLOAD_BRIDGE_TOKEN=
# Your file-mode ASR with speakers and word times: POST /audio/transcriptions {audio_url, model}, GET /jobs/{id};
# its basic auth as user:password
ASR_SERVICE_URL=
ASR_SERVICE_BASIC_AUTH=
# File-mode engines in order; the second takes windows the first refuses
FILE_MODELS=stepaudio-2.5-asr-8006,doubao-seedasr-2.0

# --- the offline scripts only ---

# owner.py, replay_case.py: a tenant's data dir and its recordings dir
LIVE_DATA=
RECORDINGS_DIR=
# owner.py only: jsonl of windows known to be the owner's voice
OWNER_LABELS=
# eval_all.sh only: directory of ground-truth cases
CASES_DIR=
# replay_case.py / service_case.py only: EMB_MODEL (CAM++ onnx), SEG_MODEL, OWNER_SURE, LINK_MIN, OWNER_DEFAULT_DEVICE
